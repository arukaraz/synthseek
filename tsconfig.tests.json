{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@components/*": ["app/components/*"],
      "@features/*": ["app/features/*"],
      "@utils/*": ["app/utils/*"],
      "@hooks/*": ["app/hooks/*"],
      "@modules/*": ["app/modules/*"],
      "@locale": ["app/modules/i18n"],
      "@locale/*": ["app/modules/i18n/*"],
      "@theme/*": ["app/theme/*"],
      "@api/*": ["app/api/*"],
      "@server/*": ["../server/*"],
      "@test/*": ["__tests__/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "vitest.setup.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "scripts",
    "coverage",
    ".next",
    "out",
    "build",
    "dist",
    "app/components/ui/ProgressDock/__tests__/ProgressDock.plexSyncLateJoin.test.tsx",
    "app/features/auth/components/__tests__/LoginScreenContent.test.tsx",
    "app/features/content-detail/__tests__/helpers.test.ts",
