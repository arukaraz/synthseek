---
import GithubIcon from "./GithubIcon.astro";

interface Props {
  repo?: string;
  class?: string;
}

const { repo = "arukaraz/synthseek", class: className } = Astro.props;
---

<a
  href={`https://github.com/${repo}`}
  rel="noopener noreferrer"
  target="_blank"
  class:list={[
    "text-fg-muted hover:text-fg focus-ring flex items-center gap-2 rounded-lg px-3 py-2 text-[13px] transition-colors",
    className,
  ]}
>
  <GithubIcon />
  <span class="font-mono text-[12px]">{repo}</span>
</a>
