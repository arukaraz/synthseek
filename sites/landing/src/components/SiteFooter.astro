---
import GithubLink from "@synthseek/sites-shared/components/GithubLink.astro";

import { DOCS_URL, GITHUB_REPO } from "../data/content";
---

<footer class="border-fg/10 border-t">
  <div class="lp-pad mx-auto flex max-w-[1140px] flex-wrap items-center gap-4 py-6">
    <GithubLink repo={GITHUB_REPO} class="-ml-3" />
    <a href={DOCS_URL} class="text-fg-muted hover:text-fg ml-auto text-[13px] no-underline transition-colors">
      Documentation
    </a>
  </div>
</footer>
