---
const BLANK = "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==";
---

<div class="lp-pad lp-devices mx-auto max-w-[1140px] pt-10">
  <div class="lp-desktopframe">
    <picture>
      <source media="(min-width: 641px)" srcset="/shots/discover-desktop.webp" />
      <img
        class="lp-shot"
        src={BLANK}
        width="1520"
        height="880"
        alt="The Synthseek Discover board on a desktop browser, with the trending card and the play queue ready to continue, under a header that joins the sections and the search, and a track in the player along the bottom."
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="lp-phone">
    <div class="lp-phone-screen">
      <picture>
        <source media="(min-width: 941px)" srcset="/shots/discover-phone.webp" />
        <source media="(max-width: 640px)" srcset="/shots/discover-phone.webp" />
        <img
          class="lp-shot"
          src={BLANK}
          width="828"
          height="1584"
          alt="The same Discover board on a phone, with the trending card above the play queue, and the same track in the bar above the navigation."
          decoding="async"
        />
      </picture>
    </div>
  </div>
</div>
